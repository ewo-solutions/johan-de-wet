# Copy to .env for local work. Never commit real values.
# On Netlify set these under Site configuration > Environment variables.

# Public site URL (used for canonical, sitemap, OG). Netlify's URL is the fallback.
SITE_URL=https://www.example.co.za

# --- Browser tracking (PUBLIC_ values are embedded in the client build) ---
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
# Google Ads conversion label for /valuation/thank-you, e.g. AW-123456789/AbCdEf
PUBLIC_GADS_CONVERSION=

# --- Netlify Functions (server only, never PUBLIC_) ---
RESEND_API_KEY=
# Verified sending domain required. See README.
RESEND_FROM="Johan de Wet <johan.dewet@propertycoza.co.za>"
NOTIFY_EMAIL=johan.dewet@propertycoza.co.za
# Optional: Zapier/Make catch-hook that forwards a WhatsApp notification to Johan
NOTIFY_WEBHOOK_URL=
# Meta Conversions API (server-side, deduplicated by event_id)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: Events Manager "Test events" code while testing
META_TEST_EVENT_CODE=
# Rate limit: max submissions per IP per hour (default 5)
RATE_LIMIT_PER_HOUR=5
