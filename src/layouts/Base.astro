---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '../styles/global.css';
import interUrl from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import playfairUrl from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import MobileBar from '../components/MobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, ASSETS } from '../config';

const {
  title,
  description,
  ogImage = ASSETS.ogDefault,
  noindex = false,
  minimal = false,
  jsonLd = null,
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://www.example.co.za');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, site).toString();
const og = new URL(ogImage, site).toString();
const bookHref = path === '/' || path === '/valuation' ? '#book' : '/valuation';

const env = import.meta.env;
const clientCfg = {
  pixelId: env.PUBLIC_META_PIXEL_ID || '',
  ga4Id: env.PUBLIC_GA4_ID || '',
  gadsConversion: env.PUBLIC_GADS_CONVERSION || '',
};
---
<!doctype html>
<html lang="en-ZA" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#9a090d" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header minimal={minimal} bookHref={bookHref} />
    <main id="main"><slot /></main>
    <Footer minimal={minimal} />
    <MobileBar bookHref={bookHref} />
    <ConsentBanner />
    <script type="application/json" id="jdw-config" set:html={JSON.stringify(clientCfg)} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
