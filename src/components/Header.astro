---
import Wordmark from './Wordmark.astro';
import { SITE } from '../config';
const { minimal = false, bookHref = '/valuation' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ['/reports', 'Reports'],
  ['/insights', 'Insights'],
  ['/about', 'About'],
];
---
<header class="site-header">
  <div class="wrap">
    <Wordmark />
    {!minimal && (
      <nav class="nav" id="site-nav" data-open="false" aria-label="Main">
        <ul>
          {links.map(([href, label]) => (
            <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <a class="header-phone" href={SITE.phoneHref} data-track="phone" data-place="header" aria-label={`Call Johan on ${SITE.phoneDisplay}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
      <span class="num">{SITE.phoneDisplay}</span>
    </a>
    {!minimal && <a class="btn header-cta" href={bookHref}>Free valuation</a>}
    {!minimal && <button class="menu-btn" type="button" data-menu-button aria-expanded="false" aria-controls="site-nav">Menu</button>}
  </div>
</header>
