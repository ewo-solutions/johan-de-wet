---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import ReportCards from '../../components/ReportCards.astro';
import ClosingBanner from '../../components/ClosingBanner.astro';
import { getLatestReports } from '../../lib/reports';
const __r = await getLatestReports();
const quarter = __r.sort((a,b)=>+b.published-+a.published)[0]?.quarter ?? '';
---
<Base
  title={`Paardevlei property prices by complex · Free ${quarter} reports · Johan de Wet`}
  description="A free report for every Paardevlei complex, every quarter, built from registered sales. Choose De Velde, Paardevlei Lifestyle Estate, Paardevlei Square or The Jade."
>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">Free quarterly reports</p>
      <h1>Your complex. Every registered sale.</h1>
      <p class="lede">One report per complex, every quarter, free. Choose yours and it lands in your inbox.</p>
      <ReportCards />
    </div>
  </section>
  <section class="section" aria-labelledby="other-h">
    <div class="wrap split">
      <div>
        <p class="kicker">Somewhere else?</p>
        <h2 id="other-h">Not in one of these complexes?</h2>
        <p>Leave your details and your suburb. I am adding more Somerset West suburbs and will let you know when yours is ready.</p>
      </div>
      <LeadForm kind="suburb" id="suburb-hub" buttonLabel="Keep me posted" />
    </div>
  </section>
  <ClosingBanner />
</Base>
