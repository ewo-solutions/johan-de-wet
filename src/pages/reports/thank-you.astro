---
import Base from '../../layouts/Base.astro';
---
<Base title="Your report is on its way · Johan de Wet" description="Your free complex report is on its way." noindex>
  <section class="thanks">
    <div class="wrap">
      <p class="kicker">Report requested</p>
      <h1>On its way.</h1>
      <p class="lede">Check your inbox in the next minute, and look in promotions if it is not there. The Q3 edition follows as soon as the data is released.</p>
      <h2 style="margin-top:2em;font-size:1.5rem">Curious what your own unit is worth?</h2>
      <p>A free valuation takes forty-five minutes and comes with no obligation.</p>
      <div class="btn-row">
        <a class="btn" href="/valuation">Request a free valuation</a>
        <a class="btn btn--secondary" href="/reports">Back to the reports</a>
      </div>
    </div>
  </section>
</Base>
